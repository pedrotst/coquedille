module zeroneqS.
data nat : ★ =
  | O : nat
  | S : nat ➔ nat.

data eq (A : ★) (x : A) : A ➔ ★ =
  | eq_refl : eq x.

eq_ind : ∀ A : ★ . Π x : A . ∀ P : A ➔ ★ . Π eq_refl' : P x . Π a : A . Π e : eq ·A x a . P a = Λ A : ★ . λ x : A . Λ P : A ➔ ★ . λ eq_refl' : P x . λ a : A . λ e : eq ·A x a . σ e @(λ a0 : A . λ e0 : eq ·A x a0 . P a0) {
  | eq_refl ➔ eq_refl' 
 }.

data True : ★ =
  | I : True.

False : ★ = ∀ X : ★ . X.

False_ind : ∀ P : ★ . False ➔ P = Λ P : ★ . λ f : False . f ·P.

not : Π A : ★ . ★ = λ A : ★ . A ➔ False.

O_S : Π n : nat . not ·(eq ·nat O (S n)) = λ n : nat . λ H : eq ·nat O (S n) . δ - ( σ H @(λ x : nat . λ _ : eq ·nat O x . { O ≃ x }) {
  | eq_refl ➔ β 
 }).


